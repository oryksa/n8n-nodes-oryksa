{
	"name": "n8n-nodes-oryksa",
	"version": "0.1.3",
	"description": "ORYKSA for n8n: use ORYKSA as the AI model of your flows, ask your ORYKSA assistant, let it act with approval, and start flows from ORYKSA events.",
	"license": "MIT",
	"homepage": "https://oryksa.com",
	"keywords": [
		"n8n-community-node-package",
		"oryksa",
		"ai",
		"assistant",
		"llm"
	],
	"author": {
		"name": "Weslley Harakawa",
		"email": "info@oryksa.com",
		"url": "https://github.com/weslleyharakawa"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/oryksa/n8n-nodes-oryksa.git"
	},
	"bugs": {
		"url": "https://github.com/oryksa/n8n-nodes-oryksa/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo",
		"!dist/**/*.map"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OryksaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Oryksa/Oryksa.node.js",
			"dist/nodes/Oryksa/OryksaTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
